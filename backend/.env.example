PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/ps9_emergency_demo
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173

# Demo Seeding (Active only when NODE_ENV !== 'production')
ENABLE_DEMO_SEEDING=true
DEMO_SEED_PASSWORD=change_me_in_production

# Operational Thresholds (Configurable)
TARGET_RESPONSE_TIME_MINUTES=8
CRITICAL_DISPATCH_TIMEOUT_MINUTES=5

# AI Engine Configuration (Reserved for Phase 3)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
